{
  "name": "neo-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/enable-cookie-encryption.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs && node e2e/login.mjs",
    "start": "node build.mjs && electron .",
    "e2e:security": "node e2e/run-security.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/node": "26.6.6",
    "electron": "45.2.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "description": "AI-native developer browser",
  "main": "dist/main.cjs"
}
